# Mappls (MapmyIndia) Web Maps API Configuration for Smart Bike TFT Cluster
# To enable live Mappls vector maps & routing, set your Mappls Static Key below:
# VITE_MAPPLS_API_KEY=your_mappls_static_key_here
#
# Mappls Console: https://auth.mappls.com/console/
# If left blank, the TFT automatically runs in high-fidelity mock demo mode with zero errors.
VITE_MAPPLS_API_KEY=
