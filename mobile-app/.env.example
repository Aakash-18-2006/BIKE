# Mappls (MapmyIndia) Web Maps API Configuration for Smart Bike Mobile App
# Obtain key from Mappls Console: https://auth.mappls.com/console/
VITE_MAPPLS_API_KEY=your_mappls_api_key_here

# Optional: Smart Bike Cloud / Local Backend WebSocket Gateway URL
# Defaults to http://localhost:5000 if not specified
VITE_BACKEND_URL=http://localhost:5000
