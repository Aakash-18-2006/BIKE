# Backend Environment Variables
PORT=5000
MQTT_PORT=1883
MQTT_WS_PORT=8883
MONGO_URI=mongodb://localhost:27017/smart_bike
USE_MEMORY_DB=true
JWT_SECRET=smart_bike_hyper_secure_jwt_secret_9981
JWT_EXPIRES_IN=7d
COMMAND_TIMEOUT_MS=15000
HEARTBEAT_TIMEOUT_MS=90000
# CORS Configuration (comma-separated origins or * for open development)
CORS_ORIGIN=*

# Mappls Maps & Navigation API Key (used by backend search, geocoding & routing proxies)
MAPPLS_API_KEY=your_mappls_api_key_here
